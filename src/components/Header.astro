---
import Icon from './Icon.astro';
import site from '../data/site.json';
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Stay Dry – home">
      <picture>
        <source srcset="/images/logo-simple-240.webp" type="image/webp" />
        <img class="brand-logo" src="/images/logo-simple-240.png" alt="" width="212" height="240" />
      </picture>
      <span class="brand-text">
        <span class="brand-name">Stay Dry</span>
        <span class="brand-tag">{site.tagline}</span>
      </span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Main" data-nav>
      <ul>
        <li><a href="/damp-surveys/">Damp Surveys</a></li>
        <li><a href="/services/">Services</a></li>
        <li><a href="/landlords/">Landlords</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li class="nav-cta"><a class="btn btn-primary btn-lg" href="/contact/">Book a survey</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a class="header-phone" href={site.phoneHref}>
        <Icon name="phone" />
        <span>{site.phoneDisplay}</span>
      </a>
      <a class="btn btn-primary" href="/contact/">Book a survey</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" data-menu-toggle>
        <Icon name="menu" cls="icon-menu" />
        <Icon name="close" cls="icon-close" />
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const nav = document.querySelector('[data-nav]');
  const toggle = document.querySelector('[data-menu-toggle]');

  // Highlight the current page in the menu
  const here = window.location.pathname.replace(/\/?$/, '/');
  document.querySelectorAll('.main-nav a:not(.btn)').forEach((link) => {
    const href = (link.getAttribute('href') || '').replace(/\/?$/, '/');
    if (href !== '/' && here.startsWith(href)) link.setAttribute('aria-current', 'page');
  });

  // Mobile menu open / close
  const setOpen = (open) => {
    if (!nav || !toggle) return;
    nav.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', (e) => {
    const opening = toggle.getAttribute('aria-expanded') !== 'true';
    setOpen(opening);
    // Opened with the keyboard (Enter/Space)? Move straight to the first menu link.
    if (opening && e.detail === 0) nav?.querySelector('a')?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
    setOpen(false);
    toggle.focus(); // back to the menu button
  });
  // Close the menu when keyboard focus moves anywhere outside the menu and its button
  document.addEventListener('focusin', (e) => {
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    const t = e.target;
    if (t instanceof Node && !nav?.contains(t) && t !== toggle) setOpen(false);
  });
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Subtle shadow once the page scrolls
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
